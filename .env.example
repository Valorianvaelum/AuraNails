DJANGO_SECRET_KEY=dev-only-aura-nails-secret-key-change-me-2026
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
AURANAILS_FRONTEND_URL=http://localhost:5174

POSTGRES_DB=auranails_dev
POSTGRES_USER=auranails
POSTGRES_PASSWORD=auranails_dev_password

VITE_API_URL=http://localhost:8001/api

# Recuperación de contraseña.
DJANGO_PASSWORD_RESET_TIMEOUT=3600
DJANGO_PASSWORD_RESET_REQUEST_RATE=5/hour
DJANGO_PASSWORD_RESET_CONFIRM_RATE=10/hour

# Por defecto, Docker imprime los correos en la consola del backend.
# Para una prueba real, cambiar a smtp.EmailBackend y completar los datos del proveedor.
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false
DJANGO_EMAIL_TIMEOUT=10
DJANGO_DEFAULT_FROM_EMAIL=AuraNails <no-responder@auranails.local>
