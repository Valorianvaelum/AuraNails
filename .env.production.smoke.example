# Solo para validar localmente el stack productivo por HTTP.
# Copiar como .env.production. No utilizar estos valores en un servidor real.

AURANAILS_HTTP_PORT=8080

DJANGO_SECRET_KEY=smoke-local-only-aura-nails-secret-key-change-before-production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
AURANAILS_FRONTEND_URL=http://localhost:8080

DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false
DJANGO_BEHIND_HTTPS_PROXY=false

DJANGO_RUN_MIGRATIONS=true
DJANGO_DB_CONN_MAX_AGE=60
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

DJANGO_PASSWORD_RESET_TIMEOUT=3600
DJANGO_PASSWORD_RESET_REQUEST_RATE=5/hour
DJANGO_PASSWORD_RESET_CONFIRM_RATE=10/hour
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DJANGO_EMAIL_HOST=
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false
DJANGO_EMAIL_TIMEOUT=60
DJANGO_DEFAULT_FROM_EMAIL="AuraNails <no-responder@auranails.local>"

POSTGRES_DB=auranails_prod_smoke
POSTGRES_USER=auranails_prod_smoke
POSTGRES_PASSWORD=smoke-local-database-password-change-before-production
POSTGRES_HOST=db
POSTGRES_PORT=5432

VITE_API_URL=/api
