# Copiar como .env.production y reemplazar todos los valores de ejemplo.
# No versionar el archivo real ni reutilizar credenciales de desarrollo.

DJANGO_SECRET_KEY=reemplazar-por-una-clave-larga-aleatoria-y-privada
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=app.ejemplo.com
DJANGO_CORS_ALLOWED_ORIGINS=https://app.ejemplo.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.ejemplo.com
AURANAILS_FRONTEND_URL=https://app.ejemplo.com

# Mantener true cuando la aplicación se publica exclusivamente por HTTPS.
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true

# Activar cuando un proxy inverso confiable termina TLS y envía X-Forwarded-Proto.
DJANGO_BEHIND_HTTPS_PROXY=true

# Recuperación de contraseña. El enlace vence en una hora por defecto.
DJANGO_PASSWORD_RESET_TIMEOUT=3600
DJANGO_PASSWORD_RESET_REQUEST_RATE=5/hour
DJANGO_PASSWORD_RESET_CONFIRM_RATE=10/hour
DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
DJANGO_EMAIL_HOST=smtp.ejemplo.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=usuario-smtp
DJANGO_EMAIL_HOST_PASSWORD=reemplazar-por-clave-smtp
DJANGO_EMAIL_USE_TLS=true
DJANGO_EMAIL_USE_SSL=false
DJANGO_EMAIL_TIMEOUT=60
DJANGO_DEFAULT_FROM_EMAIL=AuraNails <no-responder@app.ejemplo.com>

POSTGRES_DB=auranails
POSTGRES_USER=auranails
POSTGRES_PASSWORD=reemplazar-por-una-clave-de-base-de-datos-segura
POSTGRES_HOST=db
POSTGRES_PORT=5432

VITE_API_URL=https://app.ejemplo.com/api
