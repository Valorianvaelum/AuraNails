# Copiar como .env.production y reemplazar todos los valores de ejemplo.
# No versionar el archivo real ni reutilizar credenciales de desarrollo.

DJANGO_SECRET_KEY=reemplazar-por-una-clave-larga-aleatoria-y-privada
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=app.ejemplo.com
DJANGO_CORS_ALLOWED_ORIGINS=https://app.ejemplo.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://app.ejemplo.com

# Mantener true cuando la aplicación se publica exclusivamente por HTTPS.
DJANGO_SESSION_COOKIE_SECURE=true
DJANGO_CSRF_COOKIE_SECURE=true
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=true
DJANGO_SECURE_HSTS_PRELOAD=true

# Activar cuando un proxy inverso confiable termina TLS y envía X-Forwarded-Proto.
DJANGO_BEHIND_HTTPS_PROXY=true

POSTGRES_DB=auranails
POSTGRES_USER=auranails
POSTGRES_PASSWORD=reemplazar-por-una-clave-de-base-de-datos-segura
POSTGRES_HOST=db
POSTGRES_PORT=5432

VITE_API_URL=https://app.ejemplo.com/api
